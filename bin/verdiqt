      const { clearConfig: clearConfig2 } = await Promise.resolve().then(() => (init_config(), config_exports));
      clearConfig2();
      printOk("Logged out. Token removed from disk.");
      return true;
    };
    printMainHeader = () => {
      process.stdout.write(
        `
${color.gray("\u2500".repeat(48))}
  ${color.bold("Verdiqt")} ${color.gray("\xB7")} interactive console
${color.gray("\u2500".repeat(48))}
`
      );
    };
    runWizard = async () => {
      if (process.env.VERDIQT_DEBUG === "1") {
        printInfo(
          `stdin tty=${!!process.stdin.isTTY} stdout tty=${!!process.stdout.isTTY} cwd=${process.cwd()}`
        );
      }
      if (!process.stdin.isTTY) {
        printErr(
          "verdiqt expects a TTY on stdin for the interactive console. Run it directly in a terminal (don't pipe or redirect stdin)."
        );
        return EXIT.ERROR;
      }
      suppressStdin();
      void fetch(`${resolveBaseUrl()}/api/health`).catch(() => {
      });
      try {
        await bootstrapAuth();
      } catch (err) {
        if (isCancelled(err)) {
          printErr("cancelled by user");
          return EXIT.ERROR;
        }
        printErr(`Login failed: ${err instanceof Error ? err.message : String(err)}`);
        if (process.env.VERDIQT_DEBUG === "1" && err instanceof Error && err.stack) {
          process.stderr.write(`${color.gray(err.stack)}
`);
        }
        return EXIT.ERROR;
      }
      while (true) {
        printMainHeader();
        let choice;
        try {
          choice = await select(
            "What would you like to do?",
            [
              { value: "scan", label: "Run a scan", hint: "text \xB7 image \xB7 video \xB7 landing page" },
              { value: "agent", label: "Attach an agent", hint: "Claude Code \xB7 Codex \xB7 Aider \xB7 \u2026" },
              { value: "recent", label: "Recent scans", hint: "your last 10" },
              { value: "account", label: "Account", hint: "tier \xB7 quota \xB7 workbench link" },
              { value: "logout", label: "Log out" },
              { value: "exit", label: "Exit" }
            ],
            { default: 1 }
          );
        } catch (err) {
          if (isCancelled(err)) {
            process.stdout.write("\n");
            let leave = false;
            try {
              leave = await confirm("Exit Verdiqt?", { default: false });
            } catch {
              leave = false;
            }
            if (leave) {
              printOk("See you later.");
              return EXIT.PASS;
            }
            printInfo("Back to the main menu.");
            continue;
          }
          throw err;
        }
        if (choice === "exit") {
          printOk("See you later.");
          return EXIT.PASS;
        }
        try {
          if (choice === "scan") await runScanFlow();
          else if (choice === "agent") await runAttachAgentFlow();
          else if (choice === "recent") await runRecentScans();
          else if (choice === "account") await runAccountFlow();
          else if (choice === "logout") {
            const cleared = await runLogoutFlow();
            if (cleared) {
              await bootstrapAuth();
            }
          }
        } catch (err) {
          if (isCancelled(err)) {
            process.stdout.write("\n");
            printInfo("Cancelled \u2014 back to the main menu.");
            continue;
          }
          printErr(err instanceof Error ? err.message : String(err));
          if (process.env.VERDIQT_DEBUG === "1" && err instanceof Error && err.stack) {
            process.stderr.write(`${color.gray(err.stack)}
`);
          }
        }
      }
    };
    isCancellation = isCancelled;
  }
});

