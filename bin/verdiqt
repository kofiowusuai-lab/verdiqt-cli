var VERSION = "0.1.0";
var TOP_LEVEL_BANNER_TRIGGERS = /* @__PURE__ */ new Set(["--help", "-h", "--version", "-V", "help"]);
var argv = process.argv.slice(2);
var wantsWizard = argv.length === 0;
var wantsTopLevelBanner = wantsWizard || TOP_LEVEL_BANNER_TRIGGERS.has(argv[0]);
var program2 = new Command();
program2.name("verdiqt").description("Pre-flight ad creative against the Verdiqt policy index").version(VERSION, "-V, --version", "Print CLI version").option("--debug", "Print stack traces for unexpected errors").showHelpAfterError("(see `verdiqt <command> --help`)").configureHelp({ sortSubcommands: true });
registerLogin(program2);
