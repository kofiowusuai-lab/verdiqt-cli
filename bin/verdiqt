// src/banner.ts
var isTTY2 = !!process.stdout.isTTY && process.env.NO_COLOR == null;
var sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
var ESC = "\x1B[";
var rgb = (r, g, b, s) => `${ESC}38;2;${r};${g};${b}m${s}${ESC}39m`;
var dim = (s) => `${ESC}2m${s}${ESC}22m`;
var ACCENT = [72, 213, 151];
var ACCENT_HOVER = [93, 227, 164];
var ACCENT_DEEP = [43, 179, 122];
var FG_FAINT = [92, 96, 108];
var ART = [
  "\u2588\u2588\u2557   \u2588\u2588\u2557\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2557\u2588\u2588\u2588\u2588\u2588\u2588\u2557 \u2588\u2588\u2588\u2588\u2588\u2588\u2557 \u2588\u2588\u2557 \u2588\u2588\u2588\u2588\u2588\u2588\u2557 \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2557",
  "\u2588\u2588\u2551   \u2588\u2588\u2551\u2588\u2588\u2554\u2550\u2550\u2550\u2550\u255D\u2588\u2588\u2554\u2550\u2550\u2588\u2588\u2557\u2588\u2588\u2554\u2550\u2550\u2588\u2588\u2557\u2588\u2588\u2551\u2588\u2588\u2554\u2550\u2550\u2550\u2588\u2588\u2557\u255A\u2550\u2550\u2588\u2588\u2554\u2550\u2550\u255D",
  "\u2588\u2588\u2551   \u2588\u2588\u2551\u2588\u2588\u2588\u2588\u2588\u2557  \u2588\u2588\u2588\u2588\u2588\u2588\u2554\u255D\u2588\u2588\u2551  \u2588\u2588\u2551\u2588\u2588\u2551\u2588\u2588\u2551   \u2588\u2588\u2551   \u2588\u2588\u2551",
  "\u255A\u2588\u2588\u2557 \u2588\u2588\u2554\u255D\u2588\u2588\u2554\u2550\u2550\u255D  \u2588\u2588\u2554\u2550\u2550\u2588\u2588\u2557\u2588\u2588\u2551  \u2588\u2588\u2551\u2588\u2588\u2551\u2588\u2588\u2551\u2584\u2584 \u2588\u2588\u2551   \u2588\u2588\u2551",
  " \u255A\u2588\u2588\u2588\u2588\u2554\u255D \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2557\u2588\u2588\u2551  \u2588\u2588\u2551\u2588\u2588\u2588\u2588\u2588\u2588\u2554\u255D\u2588\u2588\u2551\u255A\u2588\u2588\u2588\u2588\u2588\u2588\u2554\u255D   \u2588\u2588\u2551",
  "  \u255A\u2550\u2550\u2550\u255D  \u255A\u2550\u2550\u2550\u2550\u2550\u2550\u255D\u255A\u2550\u255D  \u255A\u2550\u255D\u255A\u2550\u2550\u2550\u2550\u2550\u255D \u255A\u2550\u255D \u255A\u2550\u2550\u2580\u2580\u2550\u255D    \u255A\u2550\u255D"
];
var ART_WIDTH = Math.max(...ART.map((l) => l.length));
var ART_HEIGHT = ART.length;
var lerp = (a, b, t) => Math.round(a + (b - a) * t);
var lerp3 = (a, b, t) => [lerp(a[0], b[0], t), lerp(a[1], b[1], t), lerp(a[2], b[2], t)];
var colourFor = (col, wave) => {
  const d = col - wave;
  if (d <= -3) return ACCENT;
  if (d <= -1) {
    const t = (d + 3) / 2;
    return lerp3(ACCENT, ACCENT_HOVER, t);
  }
  if (d === 0) return ACCENT;
  if (d <= 4) {
    const t = 1 - d / 5;
    return lerp3(FG_FAINT, ACCENT_DEEP, t);
  }
  return FG_FAINT;
};
var renderFrame = (wave) => {
  let out = "";
  for (const line of ART) {
    for (let i = 0; i < line.length; i++) {
      const ch = line[i];
      if (ch === " ") {
        out += " ";
        continue;
      }
      const [r, g, b] = colourFor(i, wave);
      out += rgb(r, g, b, ch);
    }
    out += "\n";
  }
  return out;
};
var subtitle = (version) => {
  const chevrons = rgb(ACCENT[0], ACCENT[1], ACCENT[2], "\u25B8\u25B8\u25B8");
  return `   ${chevrons}  ${dim("VERDICT ENGINE")}   ${dim(`v${version}`)}

`;
};
var printBanner = async (version) => {
  if (!isTTY2) {
    process.stdout.write(`
VERDIQT  v${version}
Verdict engine \u2014 pre-flight ad creative against the policy index.

`);
    return;
  }
  process.stdout.write("\n");
  process.stdout.write(renderFrame(-100));
  for (let wave = -3; wave <= ART_WIDTH + 3; wave += 2) {
    process.stdout.write(`${ESC}${ART_HEIGHT}A\r`);
    process.stdout.write(renderFrame(wave));
    await sleep(25);
  }
  process.stdout.write(`${ESC}${ART_HEIGHT}A\r`);
  process.stdout.write(renderFrame(ART_WIDTH + 100));
  process.stdout.write(subtitle(version));
};

// src/cmd/login.ts
var import_promises5 = require("readline/promises");
var import_node_process2 = require("process");
init_api();
init_config();
init_exit_codes();
init_util();
var promptToken = async () => {
  const rl = (0, import_promises5.createInterface)({ input: import_node_process2.stdin, output: import_node_process2.stdout });
  try {
    const answer = await rl.question(`${color.cyan("Token")} (vrdq_\u2026): `);
    return answer.trim();
  } finally {
    rl.close();
  }
};
var promptBaseUrl = async (current) => {
  const rl = (0, import_promises5.createInterface)({ input: import_node_process2.stdin, output: import_node_process2.stdout });
  try {
    const answer = await rl.question(
      `${color.cyan("Base URL")} [${color.gray(current)}]: `
    );
    const trimmed = answer.trim();
    return trimmed || current;
  } finally {
    rl.close();
  }
};
var registerLogin = (program3) => {
  program3.command("login").description("Save a Verdiqt API token (mint one at /settings)").option("-t, --token <token>", "API token (vrdq_\u2026)").option("-b, --base-url <url>", "Override base URL (e.g. http://localhost:3000)").option("--no-prompt", "Fail instead of prompting if a token is missing").action(async (opts) => {
    const existing = readConfig();
    const tokenFromFlag = !!opts.token;
    let token = opts.token?.trim();
    let baseUrl = opts.baseUrl?.trim() ?? existing.baseUrl;
    if (!token) {
      if (opts.prompt === false) {
        printErr("--token is required when --no-prompt is set.");
        process.exit(EXIT.ERROR);
      }
      token = await promptToken();
    }
    if (!token || !token.startsWith("vrdq_")) {
      printErr("Token must start with `vrdq_`.");
      process.exit(EXIT.ERROR);
    }
    if (!tokenFromFlag && !opts.baseUrl && !existing.baseUrl && opts.prompt !== false) {
      const fallback = process.env.VERDIQT_BASE_URL || DEFAULT_BASE_URL;
      baseUrl = await promptBaseUrl(fallback);
    }
    const resolvedBaseUrl = baseUrl?.trim() || process.env.VERDIQT_BASE_URL?.trim() || DEFAULT_BASE_URL;
    const me = await request("GET", "/api/me", {
      token,
      baseUrl: resolvedBaseUrl
    });
    writeConfig({ token, baseUrl: resolvedBaseUrl });
    const summary = me.usage ? `used ${me.usage.used} / limit ${me.usage.limit}` : "unlimited";
    printOk(`Logged in as ${color.bold(me.tier)} \xB7 ${summary}`);
    const interactive = opts.prompt !== false && Boolean(process.stdin.isTTY) && Boolean(process.stdout.isTTY);
    if (interactive) {
      const { runWizard: runWizard2 } = await Promise.resolve().then(() => (init_wizard(), wizard_exports));
      const code = await runWizard2();
      process.exit(code);
    }
  });
};

