init_util();
var registerScans = (program3) => {
  const scans = program3.command("scans").description("List, fetch, and rate previous scans");
  scans.command("list").description("List recent scans").option("-p, --platform <p>", "Filter by platform").option("-i, --industry <i>", "Filter by industry").option("-v, --verdict <v>", "Filter by verdict (pass|warn|demonetize|fail)").option("-n, --limit <n>", "Page size (1\u2013100)", "20").option("--cursor <c>", "Pagination cursor (created_at of last row)").option("--json", "Print raw JSON").action(
    async (opts) => {
      const res = await request(
        "GET",
        "/api/scans",
        {
          query: {
            platform: opts.platform,
            industry: opts.industry,
            verdict: opts.verdict,
