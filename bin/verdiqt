var import_node_fs, import_node_os, import_node_path, CONFIG_DIR, CONFIG_PATH, DEFAULT_BASE_URL, readConfig, writeConfig, clearConfig, resolveToken, resolveBaseUrl, stripTrailingSlash;
var init_config = __esm({
  "src/config.ts"() {
    "use strict";
    import_node_fs = require("fs");
    import_node_os = require("os");
    import_node_path = require("path");
    CONFIG_DIR = (0, import_node_path.join)((0, import_node_os.homedir)(), ".config", "verdiqt");
    CONFIG_PATH = (0, import_node_path.join)(CONFIG_DIR, "config.json");
    DEFAULT_BASE_URL = "https://verdiqt-app-beta.vercel.app";
    readConfig = () => {
      if (!(0, import_node_fs.existsSync)(CONFIG_PATH)) return {};
      try {
        const raw = (0, import_node_fs.readFileSync)(CONFIG_PATH, "utf8");
        const parsed = JSON.parse(raw);
        return {
          token: typeof parsed.token === "string" ? parsed.token : void 0,
          baseUrl: typeof parsed.baseUrl === "string" ? parsed.baseUrl : void 0
        };
      } catch {
        return {};
      }
    };
    writeConfig = (cfg) => {
      const dir = (0, import_node_path.dirname)(CONFIG_PATH);
      if (!(0, import_node_fs.existsSync)(dir)) (0, import_node_fs.mkdirSync)(dir, { recursive: true, mode: 448 });
      const payload = JSON.stringify(cfg, null, 2);
      (0, import_node_fs.writeFileSync)(CONFIG_PATH, payload, { mode: 384 });
    };
    clearConfig = () => {
      if (!(0, import_node_fs.existsSync)(CONFIG_PATH)) return;
      (0, import_node_fs.rmSync)(CONFIG_PATH, { force: true });
    };
    resolveToken = () => {
      const fromEnv = process.env.VERDIQT_TOKEN?.trim();
      if (fromEnv) return fromEnv;
      return readConfig().token;
    };
    resolveBaseUrl = () => {
      const fromEnv = process.env.VERDIQT_BASE_URL?.trim();
      if (fromEnv) return stripTrailingSlash(fromEnv);
      const cfg = readConfig();
      if (cfg.baseUrl) return stripTrailingSlash(cfg.baseUrl);
      return DEFAULT_BASE_URL;
    };
    stripTrailingSlash = (s) => s.endsWith("/") ? s.slice(0, -1) : s;
  }
});

// src/api.ts
var api_exports = {};
__export(api_exports, {
  ApiError: () => ApiError,
  request: () => request,
  requestRaw: () => requestRaw
});
var ApiError, buildQuery, errorMessageForStatus, request, requestRaw;
var init_api = __esm({
  "src/api.ts"() {
    "use strict";
    init_config();
    ApiError = class extends Error {
      status;
      detail;
      constructor(message, status, detail) {
        super(message);
        this.name = "ApiError";
        this.status = status;
        this.detail = detail;
      }
    };
    buildQuery = (q) => {
      if (!q) return "";
      const params = new URLSearchParams();
      for (const [k, v] of Object.entries(q)) {
        if (v === void 0 || v === null) continue;
        params.set(k, String(v));
      }
      const s = params.toString();
      return s ? `?${s}` : "";
    };
    errorMessageForStatus = (status, fallback) => {
      switch (status) {
        case 401:
          return "Not logged in. Run `verdiqt login` after pasting a token from /settings.";
        case 402:
          return "Quota or budget reached. Contact your operator or open /settings.";
        case 403:
          return "Forbidden. Token does not grant access to this resource.";
        case 404:
          return "Not found.";
        case 413:
          return "Payload too large.";
        case 429:
          return "Rate limited. Slow down and retry.";
        case 500:
        case 502:
        case 503:
        case 504:
          return "Server error. Retry in a moment.";
        default:
          return fallback;
      }
    };
    request = async (method, path, opts = {}) => {
      const baseUrl = opts.baseUrl ?? resolveBaseUrl();
      const url = `${baseUrl}${path}${buildQuery(opts.query)}`;
      const headers = {
        accept: "application/json",
        ...opts.headers ?? {}
      };
      if (opts.body !== void 0 && opts.body !== null) {
        headers["content-type"] = headers["content-type"] ?? "application/json";
      }
      if (!opts.noAuth) {
        const token = opts.token ?? resolveToken();
        if (!token) {
          throw new ApiError(
            "Not logged in. Run `verdiqt login` first or set VERDIQT_TOKEN.",
            401
          );
        }
        headers.authorization = `Bearer ${token}`;
      }
      let res;
      const startedAt = Date.now();
      try {
        res = await fetch(url, {
          method,
          headers,
          body: opts.body === void 0 ? void 0 : JSON.stringify(opts.body)
        });
      } catch (err) {
        const elapsedSec = Math.round((Date.now() - startedAt) / 1e3);
        const rawMsg = err instanceof Error ? err.message : String(err);
        if (elapsedSec >= 55 && /fetch failed/i.test(rawMsg)) {
          throw new ApiError(
            `Server timed out after ${elapsedSec}s. The serverless function hit its 60-second cap on this scan. Try again \u2014 the function should be warm now \u2014 or split a long landing page / heavy creative into smaller pieces.`,
            0
          );
        }
        throw new ApiError(`Network error contacting ${baseUrl}: ${rawMsg}`, 0);
      }
      if (res.status === 204) return void 0;
      if (opts.allow404 && res.status === 404) return void 0;
      const text = await res.text();
      let parsed = null;
      if (text.length > 0) {
        try {
          parsed = JSON.parse(text);
        } catch {
          parsed = text;
        }
      }
      if (!res.ok) {
        const detail = parsed && typeof parsed === "object" ? parsed.error : void 0;
        if (res.status === 429 && detail === "scan_in_progress") {
          const friendly = parsed && typeof parsed === "object" && typeof parsed.message === "string" ? parsed.message : "Another scan is in progress. Wait for it to finish before starting a new one.";
          throw new ApiError(friendly, res.status, parsed);
        }
        const baseMsg = errorMessageForStatus(res.status, `HTTP ${res.status}`);
        const composed = detail ? `${baseMsg} (${detail})` : baseMsg;
        throw new ApiError(composed, res.status, parsed);
      }
      return parsed;
    };
    requestRaw = async (method, url, opts = {}) => {
      const headers = { ...opts.headers ?? {} };
      if (!opts.noAuth) {
        const token = opts.token ?? resolveToken();
        if (!token) {
          throw new ApiError(
            "Not logged in. Run `verdiqt login` first or set VERDIQT_TOKEN.",
            401
          );
        }
        headers.authorization = `Bearer ${token}`;
      }
      let res;
      try {
        res = await fetch(url, { method, headers, body: opts.rawBody });
      } catch (err) {
        const msg = err instanceof Error ? err.message : String(err);
        throw new ApiError(`Network error contacting ${url}: ${msg}`, 0);
      }
      return res;
    };
  }
});

