var handleError = (err) => {
  const debug = program2.opts().debug === true || process.env.VERDIQT_DEBUG === "1";
  if (isCancellation(err)) {
    printErr("cancelled by user");
    process.exit(EXIT.ERROR);
  }
  if (err instanceof ApiError) {
    printErr(err.message);
    if (debug && err.detail) {
      process.stderr.write(`${color.gray(JSON.stringify(err.detail, null, 2))}
`);
    }
    process.exit(EXIT.ERROR);
  }
  if (err instanceof Error) {
    printErr(err.message);
    if (debug && err.stack) process.stderr.write(`${color.gray(err.stack)}
`);
    process.exit(EXIT.ERROR);
  }
  printErr(String(err));
  process.exit(EXIT.ERROR);
};
process.on("unhandledRejection", handleError);
process.on("uncaughtException", handleError);
(async () => {
  try {
    if (wantsTopLevelBanner) {
      await printBanner(VERSION);
    }
    if (wantsWizard) {
      const code = await runWizard();
      process.exit(code);
    }
    await program2.parseAsync(process.argv);
  } catch (err) {
    handleError(err);
  }
})();
