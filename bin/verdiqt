// src/cmd/scan.ts
var import_promises6 = require("fs/promises");
init_config();
init_exit_codes();
init_util();
init_open_folder();
init_scan_engine();
init_api();
var ensureEnum = (value, allowed, flag) => {
  if (!allowed.includes(value)) {
    throw new Error(`Invalid ${flag} "${value}". Allowed: ${allowed.join(", ")}`);
  }
  return value;
};
var printScanSummary = (scan) => {
  const verdict = scan.llm_verdict;
  if (!verdict) {
    process.stdout.write(`${color.gray("(no verdict)")}
`);
    return;
  }
  const baseUrl = resolveBaseUrl();
  const lines = [];
  lines.push(`${color.bold("Verdict")}    ${verdictColor(verdict.overallVerdict)}`);
  lines.push(`${color.bold("Scan ID")}    ${scan.id}`);
  lines.push(`${color.bold("URL")}        ${baseUrl}/scan/${scan.id}`);
  lines.push(`${color.bold("Platform")}   ${scan.platform}${scan.sub_mode ? ` \xB7 ${scan.sub_mode}` : ""}`);
  lines.push(`${color.bold("Industry")}   ${scan.industry}`);
  if (scan.jurisdiction) lines.push(`${color.bold("Jurisdiction")} ${scan.jurisdiction}`);
  if (scan.legal_layers && scan.legal_layers.length > 0) {
    lines.push(`${color.bold("Legal")}      ${scan.legal_layers.join(", ")}`);
  }
  if (scan.destination_url) {
    lines.push(`${color.bold("Landing")}    ${truncate(scan.destination_url, 100)}`);
  }
  process.stdout.write(`${lines.join("\n")}
`);
  const checks = verdict.policyChecks ?? [];
  if (checks.length === 0) {
    process.stdout.write(`
${color.gray("No policy hits.")}
`);
  } else {
    process.stdout.write(`
${color.bold("Findings")}
`);
    for (const c of checks) {
      const conf = typeof c.confidence === "number" ? ` (${c.confidence.toFixed(2)})` : "";
      const src = c.source ? color.gray(` \xB7 ${c.source}`) : "";
      process.stdout.write(
        `  ${verdictColor(c.verdict)}${conf} ${color.bold(c.policyId)}${src}
    ${truncate(c.reasoning, 200)}
    ${color.gray(c.policyUrl)}
`
      );
    }
  }
  const rewrite = verdict.suggestedRewrite;
  if (rewrite && (rewrite.headline || rewrite.body || rewrite.callouts || rewrite.voiceoverScript)) {
    process.stdout.write(`
${color.bold("Suggested rewrite")}
`);
    if (rewrite.headline) process.stdout.write(`  ${color.bold("Headline:")} ${rewrite.headline}
`);
    if (rewrite.body) process.stdout.write(`  ${color.bold("Body:")}     ${rewrite.body}
`);
    if (rewrite.callouts) process.stdout.write(`  ${color.bold("Callouts:")} ${rewrite.callouts}
`);
    if (rewrite.voiceoverScript) process.stdout.write(`  ${color.bold("VO:")}       ${rewrite.voiceoverScript}
`);
    if (rewrite.rationale) process.stdout.write(`  ${color.gray(rewrite.rationale)}
`);
  }
};
var registerScan = (program3) => {
  program3.command("scan").description("Run a one-shot scan against the Verdiqt policy index").requiredOption("-p, --platform <p>", `Platform (${PLATFORMS.join(", ")})`).requiredOption("-i, --industry <i>", `Industry (${INDUSTRIES.join(", ")})`).option("-s, --sub-mode <m>", `Sub-mode (${SUB_MODES.join(", ")}); required for tiktok/youtube`).option("-j, --jurisdiction <j>", `Jurisdiction (${JURISDICTIONS.join(", ")})`, "US").option(
    "-l, --legal-layer <layer...>",
    `Legal layer(s) \u2014 repeatable. Allowed: ${LEGAL_LAYERS.join(", ")}`
  ).option("-c, --copy <text>", "Ad copy text").option("-C, --copy-file <path>", "Read ad copy from a file").option("--image <path>", "Image to scan (jpg/png/webp, \u226410MB)").option("--video <path>", "Video to scan (mp4/mov/webm, \u226425MB)").option("-u, --url <url>", "Landing page URL").option("--provider <p>", `LLM provider (${PROVIDERS.join(", ")})`, "openai").option("--json", "Print full scan JSON").option("--quiet", "Print only the verdict tier (pass|warn|demonetize|fail)").option("--poll-timeout <seconds>", "How long to wait for the verdict", "90").option("--open", "Auto-open the workbench verdict URL in the default browser").action(async (opts) => {
    const platform2 = ensureEnum(opts.platform, PLATFORMS, "--platform");
    const industry = ensureEnum(opts.industry, INDUSTRIES, "--industry");
    const subMode = opts.subMode ? ensureEnum(opts.subMode, SUB_MODES, "--sub-mode") : void 0;
    const jurisdiction = ensureEnum(
      opts.jurisdiction.toUpperCase(),
      JURISDICTIONS,
      "--jurisdiction"
    );
    const legalLayers = (opts.legalLayer ?? []).map(
      (l) => ensureEnum(l, LEGAL_LAYERS, "--legal-layer")
    );
    ensureEnum(opts.provider, PROVIDERS, "--provider");
    if ((platform2 === "tiktok" || platform2 === "youtube") && !subMode) {
      throw new Error(`--sub-mode is required for platform "${platform2}".`);
    }
    if (opts.copy && opts.copyFile) {
      throw new Error("Pass either --copy or --copy-file, not both.");
    }
    if (opts.image && opts.video) {
      throw new Error("Pass either --image or --video, not both.");
    }
    let adText;
    if (opts.copy) adText = opts.copy;
    else if (opts.copyFile) adText = (await (0, import_promises6.readFile)(opts.copyFile, "utf8")).trim();
    if (!adText && !opts.image && !opts.video && !opts.url) {
      throw new Error(
        "At least one of --copy, --copy-file, --image, --video, or --url is required."
      );
    }
    const log = (msg) => {
      if (!opts.quiet && !opts.json) printInfo(msg);
    };
    const common = {
      platform: platform2,
      industry,
      subMode,
      jurisdiction,
      legalLayers,
      adText,
      destinationUrl: opts.url
    };
    let scanId;
    if (opts.video) {
      log("Uploading video + sampling frames\u2026");
      const res = await submitVideoScan({ ...common, videoPath: opts.video });
      scanId = res.id;
    } else if (opts.image) {
      log("Uploading image\u2026");
      const res = await submitImageScan({ ...common, imagePath: opts.image });
      scanId = res.id;
    } else {
      log("Submitting scan\u2026");
      const res = await submitTextScan(common);
      scanId = res.id;
    }
    const timeoutSec = Number(opts.pollTimeout);
    if (!Number.isFinite(timeoutSec) || timeoutSec <= 0) {
      throw new Error("--poll-timeout must be a positive number of seconds.");
    }
    log("Waiting for verdict\u2026");
    const scan = await pollUntilReady(scanId, timeoutSec * 1e3);
    const tier = scan.llm_verdict?.overallVerdict ?? "fail";
    if (opts.json) {
      process.stdout.write(`${JSON.stringify(scan, null, 2)}
`);
    } else if (opts.quiet) {
      process.stdout.write(`${tier}
`);
    } else {
      printScanSummary(scan);
    }
    if (opts.open) {
      const baseUrl = resolveBaseUrl();
      void openUrl(`${baseUrl}/scan/${scan.id}`);
    }
    process.exit(verdictExitCode(tier));
  });
};

// src/cmd/scans.ts
init_api();
