        }
      ]);
      if (res.nextCursor) {
        process.stdout.write(
          `
${color.gray("nextCursor:")} ${res.nextCursor}
${color.gray("\u2192 verdiqt scans list --cursor")} ${res.nextCursor}
`
        );
      }
    }
  );
  scans.command("get <id>").description("Fetch a single scan by ID").option("--json", "Print raw JSON").action(async (id, opts) => {
    const res = await request(
      "GET",
      `/api/scans/${id}`
    );
    if (opts.json) {
      process.stdout.write(`${JSON.stringify(res.scan, null, 2)}
`);
      return;
    }
    const verdict = res.scan.llm_verdict?.overallVerdict ?? null;
    const baseUrl = resolveBaseUrl();
    process.stdout.write(
      [
        `${color.bold("Scan")}      ${res.scan.id}`,
        `${color.bold("URL")}       ${baseUrl}/scan/${res.scan.id}`,
        `${color.bold("Verdict")}   ${verdict ? verdictColor(verdict) : color.gray("(none)")}`,
        `${color.bold("Asset")}     ${res.scan.asset_type}`,
        `${color.bold("Platform")}  ${res.scan.platform}${res.scan.sub_mode ? ` \xB7 ${res.scan.sub_mode}` : ""}`,
        `${color.bold("Industry")}  ${res.scan.industry}`,
        `${color.bold("Created")}   ${formatDate(res.scan.created_at)}`
      ].join("\n") + "\n"
    );
  });
  scans.command("feedback <id>").description("Send up/down feedback for a scan").requiredOption("-r, --rating <up|down>", "Rating (up or down)").option("-R, --reason <text>", "Optional reason").action(async (id, opts) => {
    if (opts.rating !== "up" && opts.rating !== "down") {
      throw new Error("--rating must be `up` or `down`.");
    }
    await request("POST", `/api/scan/${id}/feedback`, {
      body: { rating: opts.rating, reason: opts.reason }
    });
    printOk(`Feedback recorded (${opts.rating}).`);
  });
};

// src/cmd/batch.ts
var import_promises7 = require("fs/promises");
init_api();
init_config();
init_api();
init_exit_codes();
init_util();
var DEFAULT_COLUMNS = [
  "headline",
  "body",
  "callouts",
  "destinationUrl",
  "platform",
  "industry",
  "subMode",
  "jurisdiction",
  "legalLayers"
];
var buildRows = (csvText, hasHeaders) => {
  const matrix = parseCsv(csvText);
  if (matrix.length === 0) return [];
  let header;
  let dataRows;
  if (hasHeaders) {
    header = matrix[0].map((h) => h.trim());
    dataRows = matrix.slice(1);
  } else {
    header = DEFAULT_COLUMNS;
    dataRows = matrix;
  }
  return dataRows.map((cells) => {
    const row = {};
    for (let i = 0; i < header.length; i++) {
      const key = header[i];
      const raw = cells[i] ?? "";
      const value = raw.trim();
      if (!value) continue;
      if (key === "legalLayers") {
        row.legalLayers = value.split(/[|,;]/).map((s) => s.trim()).filter(Boolean);
        continue;
      }
      row[key] = value;
    }
    return row;
  });
};
var printBatchSummary = (data) => {
  const baseUrl = resolveBaseUrl();
  const { batch, rows } = data;
  const verdictCounts = rows.reduce((acc, r) => {
    if (!r.llm_verdict || r.llm_verdict.queued || r.ai_model === "queued") {
      acc.queued = (acc.queued ?? 0) + 1;
      return acc;
    }
    const v = r.llm_verdict.overallVerdict ?? "unknown";
    acc[v] = (acc[v] ?? 0) + 1;
    return acc;
  }, {});
  process.stdout.write(
    [
      `${color.bold("Batch")}      ${batch.id}`,
      `${color.bold("URL")}        ${baseUrl}/batch/${batch.id}`,
      `${color.bold("Status")}     ${batch.status}`,
      `${color.bold("Progress")}   ${batch.completed_rows} / ${batch.total_rows}`,
      `${color.bold("Label")}      ${batch.label ?? color.gray("\u2014")}`,
      `${color.bold("Created")}    ${formatDate(batch.created_at)}`,
      batch.error ? `${color.bold("Error")}      ${color.red(batch.error)}` : "",
      `${color.bold("Verdicts")}   ${Object.entries(verdictCounts).map(([k, v]) => `${k === "queued" ? color.gray(`${k}:${v}`) : `${verdictColor(k)}:${v}`}`).join("  ") || color.gray("\u2014")}`
    ].filter(Boolean).join("\n") + "\n"
  );
  if (rows.length > 0) {
    process.stdout.write("\n");
    printTable(rows, [
      { header: "#", key: "batch_row_index" },
      {
        header: "Verdict",
        key: "llm_verdict",
        format: (v, row) => {
          if (row.ai_model === "queued") return color.gray("queued");
          if (v && typeof v === "object" && "overallVerdict" in v && v.queued !== true) {
            return verdictColor(v.overallVerdict);
          }
          return color.gray("\u2014");
        }
      },
      {
        header: "Copy",
        key: "ad_text",
        width: 60,
        format: (v) => v ? String(v).replace(/\s+/g, " ").slice(0, 60) : color.gray("\u2014")
      },
      {
        header: "URL",
        key: "destination_url",
        width: 50,
        format: (v) => v ? String(v) : color.gray("\u2014")
      }
    ]);
  }
};
var registerBatch = (program3) => {
  const batch = program3.command("batch").description("Bulk scan jobs from CSV");
  batch.command("upload <csv-path>").description("Upload a CSV and start a batch").option("-l, --label <text>", "Label for the batch").option("--no-headers", "Treat the first row as data; use default columns").action(async (csvPath, opts) => {
    const text = await (0, import_promises7.readFile)(csvPath, "utf8");
    const rows = buildRows(text, opts.headers !== false);
    if (rows.length === 0) {
      throw new Error("CSV has no data rows.");
    }
    const res = await request("POST", "/api/batch/upload", {
      body: { label: opts.label, rows }
    });
    printOk(`Batch ${res.batchId} queued (${rows.length} row${rows.length === 1 ? "" : "s"}).`);
    const baseUrl = resolveBaseUrl();
    process.stdout.write(
      `${color.gray("\u2192")} ${baseUrl}/batch/${res.batchId}
${color.gray("\u2192 verdiqt batch wait")} ${res.batchId}
`
    );
  });
  batch.command("status <id>").description("Print batch status + per-row verdicts").option("--json", "Print raw JSON").action(async (id, opts) => {
    const res = await request("GET", `/api/batch/${id}/status`);
    if (opts.json) {
      process.stdout.write(`${JSON.stringify(res, null, 2)}
`);
      return;
    }
    printBatchSummary(res);
  });
  batch.command("wait <id>").description("Poll until the batch is completed or failed").option("--timeout <seconds>", "Max wait in seconds", "600").option("--poll <seconds>", "Polling interval in seconds", "5").option("--quiet", "Suppress progress output").action(async (id, opts) => {
    const timeoutMs = Number(opts.timeout) * 1e3;
    const pollMs = Math.max(1e3, Number(opts.poll) * 1e3);
    if (!Number.isFinite(timeoutMs) || timeoutMs <= 0) {
      throw new Error("--timeout must be a positive number.");
    }
    const deadline = Date.now() + timeoutMs;
    let lastCompleted = -1;
    let kicked = false;
    while (Date.now() < deadline) {
      const res = await request("GET", `/api/batch/${id}/status`);
      if (!opts.quiet && res.batch.completed_rows !== lastCompleted) {
        lastCompleted = res.batch.completed_rows;
        process.stderr.write(
          `${color.gray("[wait]")} ${res.batch.status} \xB7 ${res.batch.completed_rows} / ${res.batch.total_rows}
`
        );
      }
      if (res.batch.status === "completed") {
        if (!opts.quiet) printOk(`Batch ${id} completed.`);
        process.exit(EXIT.PASS);
      }
      if (res.batch.status === "failed") {
        process.stderr.write(
          `${color.red("[err]")} Batch ${id} failed: ${res.batch.error ?? "unknown error"}
`
        );
        process.exit(EXIT.ERROR);
      }
      if (!kicked && res.batch.status === "queued" && Date.now() - new Date(res.batch.created_at).getTime() > 5e3) {
        await request("POST", `/api/batch/${id}/process`, {
          body: {}
        }).catch(() => void 0);
        kicked = true;
      }
      await new Promise((r) => setTimeout(r, pollMs));
    }
    process.stderr.write(
      `${color.red("[err]")} Timed out waiting for batch ${id} after ${opts.timeout}s.
`
    );
    process.exit(EXIT.ERROR);
  });
  batch.command("export <id>").description("Download the batch result CSV").option("-o, --out <path>", "Write to file (default: stdout)").action(async (id, opts) => {
    const baseUrl = resolveBaseUrl();
    const token = resolveToken();
    if (!token) {
      throw new ApiError("Not logged in. Run `verdiqt login` first.", 401);
    }
    const res = await requestRaw("GET", `${baseUrl}/api/batch/${id}/export`, { token });
    if (!res.ok) {
      const errText = await res.text();
      throw new ApiError(`Export failed: ${res.status} ${errText}`, res.status);
    }
    const csv = await res.text();
    if (opts.out) {
      await (0, import_promises7.writeFile)(opts.out, csv, "utf8");
      printOk(`Wrote ${opts.out} (${csv.length.toLocaleString()} bytes).`);
    } else {
      process.stdout.write(csv);
    }
  });
};

