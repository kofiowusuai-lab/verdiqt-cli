    };
  }
});

// src/util.ts
var isTTY, wrap, color, verdictColor, truncate, formatDate, printTable, printErr, printOk, printInfo, parseCsv;
var init_util = __esm({
  "src/util.ts"() {
    "use strict";
    isTTY = !!process.stdout.isTTY && process.env.NO_COLOR == null;
    wrap = (open, close) => (s) => isTTY ? `\x1B[${open}m${s}\x1B[${close}m` : s;
    color = {
      red: wrap("31", "39"),
      green: wrap("32", "39"),
      yellow: wrap("33", "39"),
      blue: wrap("34", "39"),
      magenta: wrap("35", "39"),
      cyan: wrap("36", "39"),
      gray: wrap("90", "39"),
      bold: wrap("1", "22"),
      dim: wrap("2", "22"),
      underline: wrap("4", "24")
    };
    verdictColor = (v) => {
      switch (v) {
        case "pass":
          return color.green(v.toUpperCase());
        case "warn":
          return color.yellow(v.toUpperCase());
        case "demonetize":
          return color.magenta(v.toUpperCase());
        case "fail":
          return color.red(v.toUpperCase());
        default:
          return color.gray(v.toUpperCase());
      }
    };
    truncate = (s, max = 80) => {
      if (s.length <= max) return s;
      return `${s.slice(0, max - 1)}\u2026`;
    };
    formatDate = (iso) => {
      if (!iso) return "\u2014";
      try {
        const d = new Date(iso);
        if (Number.isNaN(d.getTime())) return iso;
        return d.toISOString().replace("T", " ").replace(/\.\d+Z$/, "Z");
      } catch {
        return iso;
      }
    };
    printTable = (rows, columns) => {
      if (rows.length === 0) {
        process.stdout.write(color.gray("(no rows)\n"));
        return;
      }
      const widths = columns.map((c) => {
        const headerW = c.header.length;
        const dataW = rows.reduce((acc, r) => {
          const raw = c.format ? c.format(r[c.key], r) : String(r[c.key] ?? "");
          return Math.max(acc, raw.length);
        }, 0);
        const computed = Math.max(headerW, dataW);
        return c.width ? Math.min(computed, c.width) : computed;
      });
      const renderCell = (v, w) => {
        const truncated = v.length > w ? `${v.slice(0, w - 1)}\u2026` : v;
        return truncated.padEnd(w, " ");
      };
      const header = columns.map((c, i) => color.bold(renderCell(c.header, widths[i]))).join("  ");
      const sep = columns.map((_c, i) => color.gray("\u2500".repeat(widths[i]))).join("  ");
      process.stdout.write(`${header}
${sep}
`);
      for (const row of rows) {
        const line = columns.map((c, i) => {
          const raw = c.format ? c.format(row[c.key], row) : String(row[c.key] ?? "");
          return renderCell(raw, widths[i]);
        }).join("  ");
        process.stdout.write(`${line}
`);
      }
    };
    printErr = (msg) => {
      process.stderr.write(`${color.red("[err]")} ${msg}
`);
    };
    printOk = (msg) => {
      process.stdout.write(`${color.green("[ok]")} ${msg}
`);
    };
    printInfo = (msg) => {
      process.stdout.write(`${color.cyan("[..]")} ${msg}
`);
    };
    parseCsv = (text) => {
      const rows = [];
      let row = [];
      let field = "";
      let inQuotes = false;
      let i = 0;
      while (i < text.length) {
        const c = text[i];
        if (inQuotes) {
          if (c === '"') {
            if (text[i + 1] === '"') {
              field += '"';
              i += 2;
              continue;
            }
            inQuotes = false;
            i++;
            continue;
          }
          field += c;
          i++;
          continue;
        }
        if (c === '"') {
          inQuotes = true;
          i++;
          continue;
        }
        if (c === ",") {
          row.push(field);
          field = "";
          i++;
          continue;
        }
        if (c === "\n" || c === "\r") {
          if (c === "\r" && text[i + 1] === "\n") i++;
          row.push(field);
          rows.push(row);
          row = [];
          field = "";
          i++;
          continue;
        }
        field += c;
        i++;
      }
      if (field.length > 0 || row.length > 0) {
        row.push(field);
        rows.push(row);
      }
      return rows.filter((r) => !(r.length === 1 && r[0] === ""));
    };
  }
});

// src/lib/auth-client.ts
var validateAndPersist;
var init_auth_client = __esm({
  "src/lib/auth-client.ts"() {
    "use strict";
    init_api();
    init_config();
    validateAndPersist = async (rawToken, rawBaseUrl) => {
      const token = rawToken.trim();
      if (!token.startsWith("vrdq_")) {
        throw new Error("Token must start with `vrdq_`.");
      }
      const baseUrl = rawBaseUrl && rawBaseUrl.trim() || process.env.VERDIQT_BASE_URL?.trim() || DEFAULT_BASE_URL;
      const me = await request(
        "GET",
        "/api/me",
        { token, baseUrl }
      );
      writeConfig({ token, baseUrl });
      return { tier: me.tier, usage: me.usage ?? null, baseUrl };
    };
  }
});

// src/video.ts
var import_node_child_process, import_promises, import_node_os2, import_node_path2, import_node_util, execFileP, FRAME_COUNT, ensureBinary, probeDurationSeconds, extractFrameAt, extractAudioWav, sampleFramesAndAudio;
var init_video = __esm({
  "src/video.ts"() {
    "use strict";
    import_node_child_process = require("child_process");
    import_promises = require("fs/promises");
    import_node_os2 = require("os");
    import_node_path2 = require("path");
    import_node_util = require("util");
    execFileP = (0, import_node_util.promisify)(import_node_child_process.execFile);
    FRAME_COUNT = 10;
    ensureBinary = async (bin) => {
      try {
        await execFileP(bin, ["-version"]);
      } catch {
        const installHint = bin === "ffmpeg" ? "Install ffmpeg: `brew install ffmpeg` (macOS) or `apt-get install ffmpeg` (Debian/Ubuntu)." : "Install ffprobe (ships with ffmpeg): `brew install ffmpeg` or `apt-get install ffmpeg`.";
        throw new Error(`${bin} is not on PATH. ${installHint}`);
      }
    };
    probeDurationSeconds = async (videoPath) => {
      const { stdout: stdout3 } = await execFileP("ffprobe", [
        "-v",
        "error",
        "-show_entries",
        "format=duration",
        "-of",
        "default=noprint_wrappers=1:nokey=1",
        videoPath
      ]);
      const dur = Number(stdout3.trim());
      if (!Number.isFinite(dur) || dur <= 0) {
        throw new Error(`Could not read video duration from ${videoPath}.`);
      }
      return dur;
    };
    extractFrameAt = async (videoPath, timestamp, outPath) => {
      await execFileP("ffmpeg", [
        "-y",
        "-loglevel",
        "error",
        // -ss before -i is the fast keyframe seek; for short ads (≤90s) it is
        // accurate enough and an order of magnitude faster than post-decode seek.
        "-ss",
        timestamp.toFixed(3),
        "-i",
        videoPath,
        "-frames:v",
        "1",
        "-q:v",
        "3",
        outPath
      ]);
    };
    extractAudioWav = async (videoPath, outPath) => {
      await execFileP("ffmpeg", [
        "-y",
        "-loglevel",
        "error",
        "-i",
        videoPath,
        "-vn",
        "-ac",
        "1",
        "-ar",
        "16000",
        "-acodec",
        "pcm_s16le",
        outPath
      ]);
    };
    sampleFramesAndAudio = async (videoPath) => {
      await ensureBinary("ffmpeg");
      await ensureBinary("ffprobe");
      const duration = await probeDurationSeconds(videoPath);
      const tmp = await (0, import_promises.mkdtemp)((0, import_node_path2.join)((0, import_node_os2.tmpdir)(), "verdiqt-video-"));
      try {
        const timestamps = [];
        for (let i = 1; i <= FRAME_COUNT; i++) {
          const t = duration * i / (FRAME_COUNT + 1);
          timestamps.push(Math.max(0, Math.min(duration - 0.01, t)));
        }
        const frames = [];
        for (let i = 0; i < timestamps.length; i++) {
          const outPath = (0, import_node_path2.join)(tmp, `frame_${String(i).padStart(2, "0")}.jpg`);
          await extractFrameAt(videoPath, timestamps[i], outPath);
          const buf = await (0, import_promises.readFile)(outPath);
          frames.push({
            base64: buf.toString("base64"),
            mime: "image/jpeg",
            timestamp: Number(timestamps[i].toFixed(3))
          });
        }
        const audioOut = (0, import_node_path2.join)(tmp, "audio.wav");
        await extractAudioWav(videoPath, audioOut);
        const audioBuf = await (0, import_promises.readFile)(audioOut);
        const audioWavBase64 = audioBuf.toString("base64");
        return { frames, audioWavBase64 };
      } finally {
        try {
          await (0, import_promises.readdir)(tmp);
          await (0, import_promises.rm)(tmp, { recursive: true, force: true });
        } catch {
        }
      }
    };
  }
});

// src/lib/scan-engine.ts
var import_promises2, import_node_path3, PLATFORMS, INDUSTRIES, SUB_MODES, JURISDICTIONS, LEGAL_LAYERS, PROVIDERS, PLATFORM_LABEL, INDUSTRY_LABEL, LEGAL_LAYER_LABEL, IMAGE_MIME, VIDEO_MIME, mimeFromExt, optionalLegalLayers, uploadAsset, submitTextScan, submitImageScan, submitVideoScan, isVerdictReady, pollUntilReady;
var init_scan_engine = __esm({
  "src/lib/scan-engine.ts"() {
    "use strict";
    import_promises2 = require("fs/promises");
    import_node_path3 = require("path");
    init_api();
    init_video();
    PLATFORMS = [
      "meta",
      "google",
      "x_twitter",
      "linkedin",
      "tiktok",
      "youtube"
    ];
    INDUSTRIES = [
      "health_supplements",
      "finance",
      "crypto",
      "gambling",
      "alcohol",
      "dating",
      "ecommerce"
    ];
    SUB_MODES = ["paid", "branded", "creator"];
    JURISDICTIONS = ["US", "UK", "EU", "IN", "AU"];
    LEGAL_LAYERS = [
      "ftc_substantiation",
      "finra_finance",
      "asa_uk",
      "asci_india",
      "eu_dsa"
    ];
    PROVIDERS = ["openai"];
    PLATFORM_LABEL = {
      meta: "Meta",
      google: "Google",
      x_twitter: "X (Twitter)",
      linkedin: "LinkedIn",
      tiktok: "TikTok",
      youtube: "YouTube"
    };
    INDUSTRY_LABEL = {
      health_supplements: "Health & Supplements",
      finance: "Finance & Lending",
      crypto: "Cryptocurrency",
      gambling: "Gambling & Gaming",
      alcohol: "Alcohol",
      dating: "Dating",
      ecommerce: "E-Commerce"
    };
    LEGAL_LAYER_LABEL = {
      ftc_substantiation: "FTC substantiation",
      finra_finance: "FINRA",
      asa_uk: "ASA UK",
      asci_india: "ASCI India",
      eu_dsa: "EU DSA"
    };
    IMAGE_MIME = {
      jpg: "image/jpeg",
      jpeg: "image/jpeg",
      png: "image/png",
      webp: "image/webp"
    };
    VIDEO_MIME = {
      mp4: "video/mp4",
      mov: "video/quicktime",
      webm: "video/webm"
    };
    mimeFromExt = (path, table) => {
      const ext = path.toLowerCase().split(".").pop() ?? "";
      return table[ext] ?? null;
    };
    optionalLegalLayers = (layers) => layers && layers.length > 0 ? layers : void 0;
    uploadAsset = async (filePath, assetType) => {
      const buf = await (0, import_promises2.readFile)(filePath);
      const stats = await (0, import_promises2.stat)(filePath);
      const mimeTable = assetType === "image" ? IMAGE_MIME : VIDEO_MIME;
      const mime = mimeFromExt(filePath, mimeTable);
      if (!mime) {
        const allowed = Object.keys(mimeTable).join(", ");
        throw new Error(
          `${assetType} extension not recognized for ${(0, import_node_path3.basename)(filePath)}. Allowed: ${allowed}.`
        );
      }
      const signed = await request(
        "POST",
        "/api/upload/signed-url",
        { body: { assetType, mime, bytes: stats.size } }
      );
      const put = await requestRaw("PUT", signed.signedUrl, {
        noAuth: true,
        headers: {
          "content-type": mime,
          authorization: `Bearer ${signed.token}`,
          "x-upsert": "false"
        },
        rawBody: new Uint8Array(buf)
      });
      if (!put.ok) {
        const text = await put.text();
        throw new Error(`Upload failed (${put.status}): ${text || put.statusText}`);
      }
      return { storageKey: signed.storageKey, mime };
    };
    submitTextScan = async (input2) => {
      return request("POST", "/api/scan/text", {
        body: {
          adText: input2.adText,
          destinationUrl: input2.destinationUrl,
          platform: input2.platform,
          industry: input2.industry,
          subMode: input2.subMode,
          jurisdiction: input2.jurisdiction,
          legalLayers: optionalLegalLayers(input2.legalLayers)
        }
      });
    };
    submitImageScan = async (input2) => {
      const { storageKey, mime } = await uploadAsset(input2.imagePath, "image");
      return request("POST", "/api/scan/image", {
        body: {
          storageKey,
          mime,
          adText: input2.adText,
          destinationUrl: input2.destinationUrl,
          platform: input2.platform,
          industry: input2.industry,
          subMode: input2.subMode,
          jurisdiction: input2.jurisdiction,
          legalLayers: optionalLegalLayers(input2.legalLayers)
        }
      });
    };
    submitVideoScan = async (input2) => {
      const { storageKey, mime } = await uploadAsset(input2.videoPath, "video");
      const { frames, audioWavBase64 } = await sampleFramesAndAudio(input2.videoPath);
      return request("POST", "/api/scan/video", {
        body: {
          storageKey,
          mime,
          frames,
          audioWavBase64,
          adText: input2.adText,
          destinationUrl: input2.destinationUrl,
          platform: input2.platform,
          industry: input2.industry,
          subMode: input2.subMode,
          jurisdiction: input2.jurisdiction,
          legalLayers: optionalLegalLayers(input2.legalLayers)
        }
      });
    };
    isVerdictReady = (row) => {
      if (!row || !row.llm_verdict) return false;
      if (row.llm_verdict.queued) return false;
      return Array.isArray(row.llm_verdict.policyChecks);
    };
    pollUntilReady = async (id, timeoutMs) => {
      const deadline = Date.now() + timeoutMs;
      const delays = [750, 1e3, 1500, 2e3];
      let attempt = 0;
      while (Date.now() < deadline) {
        const res = await request("GET", `/api/scans/${id}`);
        if (isVerdictReady(res.scan)) return res.scan;
        const wait = delays[Math.min(attempt, delays.length - 1)];
        attempt++;
        await new Promise((r) => setTimeout(r, wait));
      }
      throw new ApiError(`Scan ${id} did not return a verdict within ${timeoutMs / 1e3}s.`, 0);
    };
  }
});

// src/wizard/prompts.ts
var import_promises3, import_node_process, Cancelled, suppressStdin, withRl, HIDE_CURSOR, SHOW_CURSOR, CLEAR_TO_END, KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT, KEY_HOME, KEY_END, KEY_CTRL_C, KEY_ENTER, withRawStdin, select, echoChoice, multiSelect, input, confirm, pressEnter, multilineInput, isCancelled;
var init_prompts = __esm({
  "src/wizard/prompts.ts"() {
    "use strict";
    import_promises3 = require("readline/promises");
    import_node_process = require("process");
    init_util();
    Cancelled = class extends Error {
      constructor() {
        super("cancelled by user");
        this.name = "Cancelled";
      }
    };
    suppressStdin = () => {
      if (typeof import_node_process.stdin.setRawMode === "function") import_node_process.stdin.setRawMode(true);
      import_node_process.stdin.pause();
    };
    withRl = async (fn) => {
      if (typeof import_node_process.stdin.setRawMode === "function") import_node_process.stdin.setRawMode(false);
      import_node_process.stdin.resume();
      const rl = (0, import_promises3.createInterface)({ input: import_node_process.stdin, output: import_node_process.stdout });
      rl.on("SIGINT", () => {
        rl.close();
        throw new Cancelled();
      });
      try {
        return await fn(rl);
      } finally {
        rl.close();
        suppressStdin();
      }
    };
    HIDE_CURSOR = "\x1B[?25l";
    SHOW_CURSOR = "\x1B[?25h";
    CLEAR_TO_END = "\x1B[J";
    KEY_UP = "\x1B[A";
    KEY_DOWN = "\x1B[B";
    KEY_LEFT = "\x1B[D";
    KEY_RIGHT = "\x1B[C";
    KEY_HOME = "\x1B[H";
    KEY_END = "\x1B[F";
    KEY_CTRL_C = "";
    KEY_ENTER = "\r";
    withRawStdin = async (fn) => {
      if (typeof import_node_process.stdin.setRawMode === "function") import_node_process.stdin.setRawMode(true);
      import_node_process.stdin.resume();
      import_node_process.stdin.setEncoding("utf8");
      process.stdout.write(HIDE_CURSOR);
      let pendingResolve = null;
      let pendingReject = null;
      const queue = [];
      const onData = (chunk) => {
        if (chunk === KEY_CTRL_C) {
          if (pendingReject) {
            const r = pendingReject;
            pendingResolve = null;
            pendingReject = null;
            r(new Cancelled());
          } else {
            queue.push(chunk);
          }
          return;
        }
        if (pendingResolve) {
          const r = pendingResolve;
          pendingResolve = null;
          pendingReject = null;
          r(chunk);
        } else {
          queue.push(chunk);
        }
      };
      import_node_process.stdin.on("data", onData);
      const read = () => {
        if (queue.length > 0) {
          const next = queue.shift();
          if (next === KEY_CTRL_C) return Promise.reject(new Cancelled());
          return Promise.resolve(next);
        }
        return new Promise((resolve, reject) => {
          pendingResolve = resolve;
          pendingReject = reject;
        });
      };
      try {
        return await fn(read);
      } finally {
        import_node_process.stdin.off("data", onData);
        process.stdout.write(SHOW_CURSOR);
        suppressStdin();
      }
    };
    select = async (question, options, opts = {}) => {
      if (options.length === 0) throw new Error("select() needs at least one option");
      const firstEnabled = options.findIndex((o) => !o.disabled);
      if (firstEnabled === -1) throw new Error("select() needs at least one enabled option");
      let highlight = opts.default ? Math.max(0, opts.default - 1) : firstEnabled;
      if (options[highlight]?.disabled) highlight = firstEnabled;
      let lastLines = 0;
      const render = () => {
        if (lastLines > 0) {
          process.stdout.write(`\x1B[${lastLines}A\r${CLEAR_TO_END}`);
        }
        let lines = 0;
        process.stdout.write(`${color.cyan("?")} ${color.bold(question)}
`);
        lines++;
        options.forEach((opt, i) => {
          const isCursor = i === highlight;
          const cursor = isCursor ? color.cyan("\u203A") : " ";
          const label = opt.disabled ? color.gray(opt.label) : isCursor ? color.cyan(opt.label) : opt.label;
          const hint = opt.hint ? `  ${color.gray(opt.hint)}` : "";
          process.stdout.write(`  ${cursor} ${label}${hint}
`);
          lines++;
        });
        process.stdout.write(
          color.gray(`  ${color.cyan("\u2191\u2193")} navigate  ${color.cyan("\u23CE")} select  ${color.cyan("\u238B")} cancel
`)
        );
        lines++;
        lastLines = lines;
      };
      const clearMenu = () => {
        if (lastLines > 0) {
          process.stdout.write(`\x1B[${lastLines}A\r${CLEAR_TO_END}`);
          lastLines = 0;
        }
      };
      process.stdout.write("\n");
      return withRawStdin(async (read) => {
        render();
        while (true) {
          const ch = await read();
          if (ch === KEY_UP || ch === "k") {
            let next = highlight;
            for (let i = 0; i < options.length; i++) {
              next = (next - 1 + options.length) % options.length;
              if (!options[next].disabled) break;
            }
            highlight = next;
            render();
            continue;
          }
          if (ch === KEY_DOWN || ch === "j" || ch === "	") {
            let next = highlight;
            for (let i = 0; i < options.length; i++) {
              next = (next + 1) % options.length;
              if (!options[next].disabled) break;
            }
            highlight = next;
            render();
            continue;
          }
          if (ch === KEY_HOME) {
            highlight = options.findIndex((o) => !o.disabled);
            if (highlight === -1) highlight = 0;
            render();
            continue;
          }
          if (ch === KEY_END) {
            for (let i = options.length - 1; i >= 0; i--) {
              if (!options[i].disabled) {
                highlight = i;
                break;
              }
            }
            render();
            continue;
          }
          if (ch === KEY_ENTER || ch === "\n") {
            clearMenu();
            echoChoice(question, options[highlight].label);
            return options[highlight].value;
          }
          if (ch === "\x1B") {
            clearMenu();
            throw new Cancelled();
          }
          if (/^[0-9]$/.test(ch)) {
            const n = Number(ch);
            if (n >= 1 && n <= options.length && !options[n - 1].disabled) {
              highlight = n - 1;
              render();
              if (options.length < 10) {
                clearMenu();
                echoChoice(question, options[highlight].label);
                return options[highlight].value;
              }
            }
            continue;
          }
          void KEY_LEFT;
          void KEY_RIGHT;
        }
      });
    };
    echoChoice = (question, label) => {
      process.stdout.write(
        `${color.gray("?")} ${color.gray(question)} ${color.cyan("\u203A")} ${color.bold(label)}
`
      );
    };
    multiSelect = async (question, options, opts = {}) => {
      if (options.length === 0) return [];
      let highlight = options.findIndex((o) => !o.disabled);
      if (highlight === -1) highlight = 0;
      const checked = /* @__PURE__ */ new Set();
      let lastLines = 0;
      const render = () => {
        if (lastLines > 0) {
          process.stdout.write(`\x1B[${lastLines}A\r${CLEAR_TO_END}`);
        }
        let lines = 0;
        process.stdout.write(`${color.cyan("?")} ${color.bold(question)}
`);
        lines++;
        options.forEach((opt, i) => {
          const isCursor = i === highlight;
          const isChecked = checked.has(i);
          const cursor = isCursor ? color.cyan("\u203A") : " ";
          const box = isChecked ? color.cyan("\u25C9") : color.gray("\u25CB");
          const label = opt.disabled ? color.gray(opt.label) : isCursor ? color.cyan(opt.label) : opt.label;
          const hint = opt.hint ? `  ${color.gray(opt.hint)}` : "";
          process.stdout.write(`  ${cursor} ${box} ${label}${hint}
`);
          lines++;
        });
        process.stdout.write(
          color.gray(
            `  ${color.cyan("\u2191\u2193")} navigate  ${color.cyan("space")} toggle  ${color.cyan("\u23CE")} confirm or skip  ${color.cyan("\u238B")} cancel  ${opts.hint ? color.gray(`\xB7 ${opts.hint}`) : ""}
`
          )
        );
        lines++;
        lastLines = lines;
      };
      const clearMenu = () => {
        if (lastLines > 0) {
          process.stdout.write(`\x1B[${lastLines}A\r${CLEAR_TO_END}`);
          lastLines = 0;
        }
      };
      process.stdout.write("\n");
      return withRawStdin(async (read) => {
        render();
        while (true) {
          const ch = await read();
          if (ch === KEY_UP || ch === "k") {
            let next = highlight;
            for (let i = 0; i < options.length; i++) {
              next = (next - 1 + options.length) % options.length;
              if (!options[next].disabled) break;
            }
            highlight = next;
            render();
            continue;
          }
          if (ch === KEY_DOWN || ch === "j" || ch === "	") {
            let next = highlight;
            for (let i = 0; i < options.length; i++) {
              next = (next + 1) % options.length;
              if (!options[next].disabled) break;
            }
            highlight = next;
            render();
            continue;
          }
          if (ch === " ") {
            if (checked.has(highlight)) checked.delete(highlight);
            else if (!options[highlight].disabled) checked.add(highlight);
            render();
            continue;
          }
          if (ch === KEY_ENTER || ch === "\n") {
            const picked = Array.from(checked).sort((a, b) => a - b).map((i) => options[i]);
            clearMenu();
            const summary = picked.length === 0 ? color.gray("none") : picked.map((p) => color.bold(p.label)).join(", ");
            process.stdout.write(
              `${color.gray("?")} ${color.gray(question)} ${color.cyan("\u203A")} ${summary}
`
            );
            return picked.map((p) => p.value);
          }
          if (ch === "\x1B") {
            clearMenu();
            throw new Cancelled();
          }
        }
      });
    };
    input = async (question, opts = {}) => {
      return withRl(async (rl) => {
        const placeholder = opts.placeholder ? color.gray(` (${opts.placeholder})`) : "";
        const def = opts.default ? color.gray(` [${opts.default}]`) : "";
        while (true) {
          const raw = (await rl.question(`${color.cyan("?")} ${color.bold(question)}${placeholder}${def}
${color.cyan("> ")} `)).trim();
          if (raw) return raw;
          if (opts.default !== void 0) return opts.default;
          if (opts.allowEmpty) return "";
          process.stdout.write(color.gray("  required \u2014 please type a value\n"));
        }
      });
    };
    confirm = async (question, opts = {}) => {
      const def = opts.default ?? false;
      return withRl(async (rl) => {
        const hint = def ? "Y/n" : "y/N";
        while (true) {
          const raw = (await rl.question(`${color.cyan("?")} ${color.bold(question)} ${color.gray(`(${hint})`)} `)).trim().toLowerCase();
          if (!raw) return def;
          if (raw === "y" || raw === "yes") return true;
          if (raw === "n" || raw === "no") return false;
          process.stdout.write(color.gray(`  please answer y or n
`));
        }
      });
    };
    pressEnter = async (message) => {
      await withRl(async (rl) => {
        await rl.question(`${color.cyan("\u23CE")} ${message} ${color.gray("(press Enter)")} `);
      });
    };
    multilineInput = async (question) => {
      return new Promise((resolve, reject) => {
        if (typeof import_node_process.stdin.setRawMode === "function") import_node_process.stdin.setRawMode(true);
        import_node_process.stdin.resume();
        import_node_process.stdin.setEncoding("utf8");
        import_node_process.stdout.write("\x1B[?2004h");
        import_node_process.stdout.write(
          `
${color.cyan("?")} ${color.bold(question)}
${color.gray(
            "  Enter submits \xB7 Esc+Enter (Option+Return) or \\ + Enter for new line \xB7 Ctrl+C cancels"
          )}
${color.cyan("\u2502 ")} `
        );
        let buf = "";
        let inPaste = false;
        let pasteBuf = "";
        let escPending = false;
        const cleanup = () => {
          import_node_process.stdout.write("\x1B[?2004l");
          if (typeof import_node_process.stdin.setRawMode === "function") import_node_process.stdin.setRawMode(false);
          import_node_process.stdin.removeListener("data", onData);
          suppressStdin();
        };
        const submit = () => {
          cleanup();
          import_node_process.stdout.write("\n");
          resolve(buf.trim());
        };
        const cancel = () => {
          cleanup();
          import_node_process.stdout.write("\n");
          reject(new Cancelled());
        };
        const echoNewline = () => {
          import_node_process.stdout.write(`
${color.cyan("\u2502 ")} `);
        };
        const onData = (chunk) => {
          let i = 0;
          while (i < chunk.length) {
            if (chunk.startsWith("\x1B[200~", i)) {
              inPaste = true;
              pasteBuf = "";
              i += 6;
              continue;
            }
            if (chunk.startsWith("\x1B[201~", i)) {
              inPaste = false;
              buf += pasteBuf;
              import_node_process.stdout.write(pasteBuf.replace(/\r\n?/g, () => `
${color.cyan("\u2502 ")} `));
              pasteBuf = "";
              i += 6;
              continue;
            }
            const c = chunk[i];
            if (inPaste) {
              if (c === "\r") pasteBuf += "\n";
              else pasteBuf += c;
              i += 1;
              continue;
            }
            if (c === "\x1B") {
              if (chunk[i + 1] === "\r" || chunk[i + 1] === "\n") {
                buf += "\n";
                echoNewline();
                i += 2;
                continue;
              }
              if (chunk[i + 1] === "[") {
                let j = i + 2;
                while (j < chunk.length && /[0-9;]/.test(chunk[j])) j++;
                if (j < chunk.length) j++;
                i = j;
                continue;
              }
              if (i === chunk.length - 1) {
                escPending = true;
                i += 1;
                continue;
              }
              i += 2;
              continue;
            }
            if (escPending) {
              escPending = false;
              if (c === "\r" || c === "\n") {
                buf += "\n";
                echoNewline();
                i += 1;
                continue;
              }
              i += 1;
              continue;
            }
            if (c === "") {
              cancel();
              return;
            }
            if (c === "") {
              submit();
              return;
            }
            if (c === "\r" || c === "\n") {
              if (buf.endsWith("\\")) {
                buf = buf.slice(0, -1) + "\n";
                import_node_process.stdout.write("\b \b");
                echoNewline();
              } else {
                submit();
                return;
              }
              i += 1;
              continue;
            }
            if (c === "\x7F" || c === "\b") {
              if (buf.length === 0) {
                i += 1;
                continue;
              }
              const last = buf[buf.length - 1];
              buf = buf.slice(0, -1);
              if (last === "\n") {
              } else {
                import_node_process.stdout.write("\b \b");
              }
              i += 1;
              continue;
            }
            if (c >= " " || c === "	") {
              buf += c;
              import_node_process.stdout.write(c);
            }
            i += 1;
          }
        };
        import_node_process.stdin.on("data", onData);
      });
    };
    isCancelled = (err) => err instanceof Cancelled || err instanceof Error && err.name === "Cancelled";
  }
});

// src/wizard/campaign.ts
var import_node_fs2, import_node_os3, import_node_path4, campaignsRoot, CONFIG_FILENAME, slugify, campaignDir, creativesDir, verdictsDir, configPath, readCampaignConfig, writeCampaignConfig, createCampaign, listCampaigns, writeVerdictSnapshot;
var init_campaign = __esm({
  "src/wizard/campaign.ts"() {
    "use strict";
    import_node_fs2 = require("fs");
    import_node_os3 = require("os");
    import_node_path4 = require("path");
    campaignsRoot = () => (0, import_node_path4.join)((0, import_node_os3.homedir)(), "verdiqt");
    CONFIG_FILENAME = ".verdiqt.json";
    slugify = (raw) => {
      const trimmed = raw.trim().toLowerCase();
      const replaced = trimmed.replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 60);
      return replaced || `campaign-${Date.now()}`;
    };
    campaignDir = (slug) => (0, import_node_path4.join)(campaignsRoot(), slug);
    creativesDir = (dir) => (0, import_node_path4.join)(dir, "creatives");
    verdictsDir = (dir) => (0, import_node_path4.join)(dir, "verdicts");
    configPath = (dir) => (0, import_node_path4.join)(dir, CONFIG_FILENAME);
    readCampaignConfig = (dir) => {
      const p = configPath(dir);
      if (!(0, import_node_fs2.existsSync)(p)) return null;
      try {
        const raw = (0, import_node_fs2.readFileSync)(p, "utf8");
        return JSON.parse(raw);
      } catch {
        return null;
      }
    };
    writeCampaignConfig = (dir, cfg) => {
      (0, import_node_fs2.writeFileSync)(configPath(dir), JSON.stringify(cfg, null, 2), { mode: 384 });
    };
    createCampaign = (name) => {
      const slug = slugify(name);
      const root = campaignsRoot();
      if (!(0, import_node_fs2.existsSync)(root)) (0, import_node_fs2.mkdirSync)(root, { recursive: true, mode: 448 });
      const dir = campaignDir(slug);
      const existed = (0, import_node_fs2.existsSync)(dir);
      if (!existed) (0, import_node_fs2.mkdirSync)(dir, { recursive: true, mode: 448 });
      (0, import_node_fs2.mkdirSync)(creativesDir(dir), { recursive: true, mode: 448 });
      (0, import_node_fs2.mkdirSync)(verdictsDir(dir), { recursive: true, mode: 448 });
      let config = readCampaignConfig(dir);
      if (!config) {
        config = { name, createdAt: (/* @__PURE__ */ new Date()).toISOString() };
        writeCampaignConfig(dir, config);
      }
      return { dir, slug, config };
    };
    listCampaigns = () => {
      const root = campaignsRoot();
      if (!(0, import_node_fs2.existsSync)(root)) return [];
      const entries = (0, import_node_fs2.readdirSync)(root);
      const out = [];
      for (const entry of entries) {
        if (entry.startsWith(".")) continue;
        const dir = (0, import_node_path4.join)(root, entry);
        let s;
        try {
          s = (0, import_node_fs2.statSync)(dir);
        } catch {
          continue;
        }
        if (!s.isDirectory()) continue;
        const config = readCampaignConfig(dir);
        if (!config) continue;
        out.push({ slug: entry, dir, config });
      }
      out.sort((a, b) => (b.config.createdAt ?? "").localeCompare(a.config.createdAt ?? ""));
      return out;
    };
    writeVerdictSnapshot = (campaignDirPath, payload) => {
      const ts = (/* @__PURE__ */ new Date()).toISOString().replace(/[:.]/g, "-");
      const path = (0, import_node_path4.join)(verdictsDir(campaignDirPath), `${ts}.json`);
      (0, import_node_fs2.writeFileSync)(path, JSON.stringify(payload, null, 2), { mode: 384 });
      return path;
    };
  }
});

// src/wizard/open-folder.ts
var import_node_child_process2, import_node_os4, TIMEOUT_MS, openTarget, openFolder, openUrl;
var init_open_folder = __esm({
  "src/wizard/open-folder.ts"() {
    "use strict";
    import_node_child_process2 = require("child_process");
    import_node_os4 = require("os");
    TIMEOUT_MS = 2e3;
    openTarget = async (target) => {
      const plat = (0, import_node_os4.platform)();
      let cmd;
      let args;
      if (plat === "darwin") {
        cmd = "open";
        args = [target];
      } else if (plat === "win32") {
        cmd = "cmd";
        args = ["/c", "start", "", target];
      } else {
        cmd = "xdg-open";
        args = [target];
      }
      return new Promise((resolve) => {
        let settled = false;
        const finish = (result) => {
          if (settled) return;
          settled = true;
          resolve(result);
        };
        try {
          const child = (0, import_node_child_process2.spawn)(cmd, args, { stdio: "ignore", detached: true });
          child.on("error", (err) => finish({ opened: false, reason: err.message }));
          setTimeout(() => finish({ opened: true }), 150);
          setTimeout(() => finish({ opened: false, reason: "spawn timeout" }), TIMEOUT_MS);
          child.unref();
        } catch (err) {
          finish({
            opened: false,
            reason: err instanceof Error ? err.message : String(err)
          });
        }
      });
    };
    openFolder = (path) => openTarget(path);
    openUrl = (url) => openTarget(url);
  }
});

// src/wizard/spinner.ts
var FRAMES, FRAME_MS, isTTY3, formatElapsed, startSpinner;
var init_spinner = __esm({
  "src/wizard/spinner.ts"() {
    "use strict";
    init_util();
    FRAMES = ["\u280B", "\u2819", "\u2839", "\u2838", "\u283C", "\u2834", "\u2826", "\u2827", "\u2807", "\u280F"];
    FRAME_MS = 80;
    isTTY3 = !!process.stdout.isTTY && process.env.NO_COLOR == null;
    formatElapsed = (startedAt) => {
      const sec = Math.floor((Date.now() - startedAt) / 1e3);
      if (sec < 60) return `${sec}s`;
      const m = Math.floor(sec / 60);
      const s = sec % 60;
      return `${m}m ${s.toString().padStart(2, "0")}s`;
    };
    startSpinner = (initialMessage) => {
      let message = initialMessage;
      const startedAt = Date.now();
      let frame = 0;
      let stopped = false;
      const render = () => {
        if (!isTTY3 || stopped) return;
        const dot = color.cyan(FRAMES[frame % FRAMES.length]);
        const elapsed = color.gray(formatElapsed(startedAt));
        process.stdout.write(`\r\x1B[2K  ${dot} ${message} ${elapsed}`);
        frame++;
      };
      let interval = null;
      if (isTTY3) {
        process.stdout.write(`  ${color.cyan(FRAMES[0])} ${message} ${color.gray("0s")}`);
        interval = setInterval(render, FRAME_MS);
      } else {
        process.stdout.write(`[..] ${message}
`);
      }
      const clearLine = () => {
        if (isTTY3) process.stdout.write("\r\x1B[2K");
      };
      return {
        update(next) {
          message = next;
          render();
        },
        succeed(next) {
          stopped = true;
          if (interval) clearInterval(interval);
          clearLine();
          const elapsed = color.gray(`(${formatElapsed(startedAt)})`);
          process.stdout.write(`  ${color.green("\u2713")} ${next} ${elapsed}
`);
        },
        fail(next) {
          stopped = true;
          if (interval) clearInterval(interval);
          clearLine();
          const elapsed = color.gray(`(${formatElapsed(startedAt)})`);
          process.stdout.write(`  ${color.red("\u2717")} ${next} ${elapsed}
`);
        },
        stop() {
          stopped = true;
          if (interval) clearInterval(interval);
          clearLine();
        }
      };
    };
  }
});

